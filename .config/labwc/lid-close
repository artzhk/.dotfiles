#!/usr/bin/env sh
# labwc port of .config/sway/lid-close
# labwc has no IPC and no bindswitch: swaymsg -> wlr-randr (wlr-output-management),
# and the lid event has to come from logind or a keybind -- see the notes at the end.
set -eu

LAPTOP="${1:-eDP-1}"

# count active external outputs
ext_active="$(wlr-randr --json \
	| jq -r --arg L "$LAPTOP" '[.[] | select(.name != $L and .enabled == true)] | length')"

if [ "$ext_active" -ge 1 ]; then
	# Disable internal so its workspaces/windows get moved to the remaining output(s)
	# (--off drops the output; wlopm would only blank it and keep the layout)
	wlr-randr --output "$LAPTOP" --off >/dev/null
else
	systemctl suspend-then-hibernate
fi

# Re-enable on lid open (sway did this with `bindswitch lid:off`):
#   wlr-randr --output eDP-1 --on
# labwc's autoEnableOutputs only covers newly *connected* outputs, not ones
# disabled here, so the re-enable has to be explicit.
