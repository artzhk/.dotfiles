// -*- mode: jsonc -*-
// waybar for labwc -- ext-workspace (waybar >= 0.14.0) plus generic modules.
// config.jsonc next to this one is the niri bar (niri/workspaces, niri/window) and
// will not run here. Launched from .config/labwc/autostart as:
//   waybar -c config-labwc.jsonc -s style-nord-$THEME.css
{
    "layer": "top",
    "position": "top",
    "height": 26,
    "spacing": 8,

    "modules-left": ["ext/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["pulseaudio", "custom/i3status", "tray"],

    "ext/workspaces": {
        "format": "{name}",
        "sort-by-number": true,
        "on-click": "activate"
    },
    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%Y-%m-%d}"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": " ",
        "format-icons": { "headphone": " ", "headset": "󰋎 ", "default": [" ", " ", " "] },
        "on-click": "alacritty -e ncpamixer"
    },
    "tray": {
        "spacing": 5
    },
    "custom/i3status": {
        "exec": "i3status",
        "format": "{}"
    }
}
