<?xml version="1.0" encoding="UTF-8"?>
<openbox_config xmlns="http://openbox.org/3.4/rc">

<resistance>
  <strength>10</strength>
  <screen_edge_strength>20</screen_edge_strength>
</resistance>

<focus>
  <focusNew>yes</focusNew>
  <followMouse>no</followMouse>
  <focusLast>yes</focusLast>
  <underMouse>no</underMouse>
  <focusDelay>200</focusDelay>
  <raiseOnFocus>no</raiseOnFocus>
</focus>

<placement>
  <policy>Smart</policy>
  <center>yes</center>
  <monitor>Active</monitor>
  <primaryMonitor>Active</primaryMonitor>
</placement>

<theme>
  <!-- a name, not a path: openbox resolves it under $XDG_DATA_HOME/themes.
       Nord-Current is a symlink flipped by darkmode/lightmode, so this file
       is never rewritten and toggling never dirties git. -->
  <name>Nord-Current</name>
  <titleLayout>LIMC</titleLayout>
  <keepBorder>yes</keepBorder>
  <animateIconify>no</animateIconify>
  <!-- ponytail: 12 suits a normal DPI; i3 uses 18, bump here if this is the hidpi panel -->
  <font place="ActiveWindow">
    <name>IosevkaTerm Nerd Font Mono</name>
    <size>12</size>
    <weight>bold</weight>
    <slant>normal</slant>
  </font>
  <font place="InactiveWindow">
    <name>IosevkaTerm Nerd Font Mono</name>
    <size>12</size>
    <weight>normal</weight>
    <slant>normal</slant>
  </font>
  <font place="MenuHeader">
    <name>IosevkaTerm Nerd Font Mono</name>
    <size>12</size>
    <weight>bold</weight>
    <slant>normal</slant>
  </font>
  <font place="MenuItem">
    <name>IosevkaTerm Nerd Font Mono</name>
    <size>12</size>
    <weight>normal</weight>
    <slant>normal</slant>
  </font>
  <font place="ActiveOnScreenDisplay">
    <name>IosevkaTerm Nerd Font Mono</name>
    <size>12</size>
    <weight>bold</weight>
    <slant>normal</slant>
  </font>
  <font place="InactiveOnScreenDisplay">
    <name>IosevkaTerm Nerd Font Mono</name>
    <size>12</size>
    <weight>normal</weight>
    <slant>normal</slant>
  </font>
</theme>

<desktops>
  <number>10</number>
  <firstdesk>1</firstdesk>
  <names>
    <name>1</name><name>2</name><name>3</name><name>4</name><name>5</name>
    <name>6</name><name>7</name><name>8</name><name>9</name><name>10</name>
  </names>
  <popupTime>600</popupTime>
</desktops>

<resize>
  <drawContents>yes</drawContents>
  <popupShow>Nonpixel</popupShow>
  <popupPosition>Center</popupPosition>
</resize>

<!-- tint2 publishes _NET_WM_STRUT_PARTIAL itself; no manual reserve needed -->
<margins>
  <top>0</top>
  <bottom>0</bottom>
  <left>0</left>
  <right>0</right>
</margins>

<dock>
  <position>TopLeft</position>
  <stacking>Above</stacking>
  <direction>Vertical</direction>
  <autoHide>no</autoHide>
</dock>

<keyboard>
  <chainQuitKey>C-g</chainQuitKey>

  <!-- ============ workspaces: same letters as .config/i3/config ============ -->
  <keybind key="W-h"><action name="GoToDesktop"><to>1</to></action></keybind>
  <keybind key="W-t"><action name="GoToDesktop"><to>2</to></action></keybind>
  <keybind key="W-g"><action name="GoToDesktop"><to>3</to></action></keybind>
  <keybind key="W-c"><action name="GoToDesktop"><to>4</to></action></keybind>
  <keybind key="W-m"><action name="GoToDesktop"><to>5</to></action></keybind>
  <!-- ws6 moved off W-x: that is the emacs chain prefix below -->
<!--  <keybind key="W-b"><action name="GoToDesktop"><to>6</to></action></keybind>-->
<!--  <keybind key="W-z"><action name="GoToDesktop"><to>7</to></action></keybind>-->
<!--  <keybind key="W-o"><action name="GoToDesktop"><to>8</to></action></keybind>-->
<!--  <keybind key="W-u"><action name="GoToDesktop"><to>9</to></action></keybind>-->
<!--  <keybind key="W-i"><action name="GoToDesktop"><to>10</to></action></keybind>-->

  <keybind key="W-S-h"><action name="SendToDesktop"><to>1</to><follow>yes</follow></action></keybind>
  <keybind key="W-S-t"><action name="SendToDesktop"><to>2</to><follow>yes</follow></action></keybind>
  <keybind key="W-S-g"><action name="SendToDesktop"><to>3</to><follow>yes</follow></action></keybind>
  <keybind key="W-S-c"><action name="SendToDesktop"><to>4</to><follow>yes</follow></action></keybind>
  <keybind key="W-S-m"><action name="SendToDesktop"><to>5</to><follow>yes</follow></action></keybind>
 <!-- <keybind key="W-S-b"><action name="SendToDesktop"><to>6</to><follow>yes</follow></action></keybind> -->
 <!-- <keybind key="W-S-z"><action name="SendToDesktop"><to>7</to><follow>yes</follow></action></keybind> -->
 <!-- <keybind key="W-S-o"><action name="SendToDesktop"><to>8</to><follow>yes</follow></action></keybind> -->
 <!-- <keybind key="W-S-u"><action name="SendToDesktop"><to>9</to><follow>yes</follow></action></keybind> -->
 <!-- <keybind key="W-S-i"><action name="SendToDesktop"><to>10</to><follow>yes</follow></action></keybind> -->

  <keybind key="W-a">
    <action name="DirectionalCycleWindows"><direction>west</direction><interactive>no</interactive></action>
  </keybind>
  <keybind key="W-n">
    <action name="DirectionalCycleWindows"><direction>south</direction><interactive>no</interactive></action>
  </keybind>
  <keybind key="W-p">
    <action name="DirectionalCycleWindows"><direction>north</direction><interactive>no</interactive></action>
  </keybind>
  <keybind key="W-e">
    <action name="DirectionalCycleWindows"><direction>east</direction><interactive>no</interactive></action>
  </keybind>

  <!-- ============ vim: half-tile (openbox stacks, so this is the "move" analog) ============ -->
  <keybind key="W-S-a">
    <action name="Unmaximize"/>
    <action name="MoveResizeTo"><x>0</x><y>0</y><width>50%</width><height>100%</height></action>
  </keybind>
  <keybind key="W-S-e">
    <action name="Unmaximize"/>
    <action name="MoveResizeTo"><x>-0</x><y>0</y><width>50%</width><height>100%</height></action>
  </keybind>
  <keybind key="W-S-p">
    <action name="Unmaximize"/>
    <action name="MoveResizeTo"><x>0</x><y>0</y><width>100%</width><height>50%</height></action>
  </keybind>
  <keybind key="W-S-n">
    <action name="Unmaximize"/>
    <action name="MoveResizeTo"><x>0</x><y>-0</y><width>100%</width><height>50%</height></action>
  </keybind>

  <!-- ============ emacs chain: W-x is the prefix, NOT C-x ============
       openbox grabs keys globally, so a real C-x binding would steal it
       from emacs itself. C-g cancels the chain (chainQuitKey above). -->
  <keybind key="W-x">
    <keybind key="o">
      <action name="NextWindow"><interactive>no</interactive><allDesktops>no</allDesktops></action>
    </keybind>
    <keybind key="k"><action name="Close"/></keybind>
    <keybind key="b">
      <action name="ShowMenu"><menu>client-list-combined-menu</menu></action>
    </keybind>
    <keybind key="i"><action name="Iconify"/></keybind>
    <keybind key="m"><action name="Maximize"/></keybind>
    <keybind key="u">
      <action name="Unmaximize"/>
      <action name="MoveResizeTo"><x>0</x><y>0</y><width>50%</width><height>100%</height></action>
    </keybind>
    <keybind key="C-c"><action name="Exit"><prompt>yes</prompt></action></keybind>
  </keybind>

  <!-- ============ misc: same as i3 ============ -->
  <keybind key="W-Return"><action name="Execute"><command>alacritty</command></action></keybind>
  <keybind key="W-d"><action name="Execute"><command>rofi -show drun</command></action></keybind>
  <keybind key="W-space"><action name="Execute"><command>rofi -show window</command></action></keybind>
  <keybind key="W-i"><action name="Execute"><command>clipton</command></action></keybind>
  <keybind key="W-S-s"><action name="Execute"><command>flameshot gui</command></action></keybind>
  <keybind key="W-q"><action name="Close"/></keybind>
  <keybind key="W-f"><action name="ToggleFullscreen"/></keybind>
  <keybind key="W-S-space"><action name="ToggleDecorations"/></keybind>
  <keybind key="W-S-r"><action name="Reconfigure"/></keybind>
  <keybind key="W-S-q"><action name="Exit"><prompt>yes</prompt></action></keybind>

  <keybind key="XF86AudioRaiseVolume"><action name="Execute"><command>pactl set-sink-volume @DEFAULT_SINK@ +10%</command></action></keybind>
  <keybind key="XF86AudioLowerVolume"><action name="Execute"><command>pactl set-sink-volume @DEFAULT_SINK@ -10%</command></action></keybind>
  <keybind key="XF86AudioMute"><action name="Execute"><command>pactl set-sink-mute @DEFAULT_SINK@ toggle</command></action></keybind>
  <keybind key="XF86AudioMicMute"><action name="Execute"><command>pactl set-source-mute @DEFAULT_SOURCE@ toggle</command></action></keybind>
  <keybind key="XF86MonBrightnessUp"><action name="Execute"><command>light -A 5</command></action></keybind>
  <keybind key="XF86MonBrightnessDown"><action name="Execute"><command>light -U 5</command></action></keybind>
  <keybind key="Print"><action name="Execute"><command>flameshot gui</command></action></keybind>
</keyboard>

<mouse>
  <dragThreshold>1</dragThreshold>
  <doubleClickTime>200</doubleClickTime>
  <screenEdgeWarpTime>0</screenEdgeWarpTime>

  <context name="Titlebar">
    <mousebind button="Left" action="Drag"><action name="Move"/></mousebind>
    <mousebind button="Left" action="DoubleClick"><action name="ToggleMaximize"/></mousebind>
    <mousebind button="Middle" action="Press"><action name="Lower"/></mousebind>
    <mousebind button="Right" action="Press"><action name="ShowMenu"><menu>client-menu</menu></action></mousebind>
  </context>
  <context name="Frame">
    <mousebind button="W-Left" action="Drag"><action name="Move"/></mousebind>
    <mousebind button="W-Right" action="Drag"><action name="Resize"/></mousebind>
    <mousebind button="W-Middle" action="Press"><action name="Lower"/></mousebind>
  </context>
  <context name="Client">
    <mousebind button="Left" action="Press"><action name="Focus"/><action name="Raise"/></mousebind>
  </context>
  <context name="Top">
    <mousebind button="Left" action="Drag"><action name="Resize"><edge>top</edge></action></mousebind>
  </context>
  <context name="Bottom">
    <mousebind button="Left" action="Drag"><action name="Resize"><edge>bottom</edge></action></mousebind>
  </context>
  <context name="Left">
    <mousebind button="Left" action="Drag"><action name="Resize"><edge>left</edge></action></mousebind>
  </context>
  <context name="Right">
    <mousebind button="Left" action="Drag"><action name="Resize"><edge>right</edge></action></mousebind>
  </context>
  <context name="Desktop">
    <mousebind button="Up" action="Click"><action name="GoToDesktop"><to>previous</to></action></mousebind>
    <mousebind button="Down" action="Click"><action name="GoToDesktop"><to>next</to></action></mousebind>
    <mousebind button="Right" action="Press"><action name="ShowMenu"><menu>root-menu</menu></action></mousebind>
    <mousebind button="Middle" action="Press"><action name="ShowMenu"><menu>client-list-combined-menu</menu></action></mousebind>
  </context>
</mouse>

<menu>
  <file>menu.xml</file>
  <hideDelay>200</hideDelay>
  <middle>no</middle>
  <submenuShowDelay>100</submenuShowDelay>
  <showIcons>no</showIcons>
  <manageDesktops>yes</manageDesktops>
</menu>

<applications>
  <application class="*">
    <decor>yes</decor>
  </application>
</applications>

</openbox_config>
