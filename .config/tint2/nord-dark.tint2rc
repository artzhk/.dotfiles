# tint2 -- Nord dark. taskbar + systray + clock, nothing else.
# bg 1 = panel, bg 2 = active task / active desktop name

rounded = 0
border_width = 0
background_color = #2e3440 100
border_color = #2e3440 100

rounded = 0
border_width = 1
background_color = #3b4252 100
border_color = #88c0d0 100

#---- panel
panel_items = TSC
panel_monitor = all
panel_position = top center horizontal
panel_size = 100% 28
panel_margin = 0 0
panel_padding = 4 0 4
panel_background_id = 1
panel_layer = top
panel_dock = 0
wm_menu = 1
strut_policy = follow_size
autohide = 0

#---- taskbar (grouped per desktop, name shown = poor man's pager)
taskbar_mode = multi_desktop
taskbar_padding = 2 0 4
taskbar_background_id = 0
taskbar_active_background_id = 0
taskbar_name = 1
taskbar_hide_inactive_tasks = 0
taskbar_name_padding = 6 0
taskbar_name_background_id = 0
taskbar_name_active_background_id = 2
taskbar_name_font = IosevkaTerm Nerd Font Mono 10
taskbar_name_font_color = #7b88a1 100
taskbar_name_active_font_color = #eceff4 100

#---- tasks
task_text = 1
task_icon = 1
task_centered = 0
task_maximum_size = 200 24
task_padding = 6 2 6
task_font = IosevkaTerm Nerd Font Mono 10
task_background_id = 0
task_active_background_id = 2
task_font_color = #d8dee9 100
task_active_font_color = #eceff4 100
task_urgent_font_color = #bf616a 100
task_iconified_font_color = #7b88a1 100

#---- systray (nm-applet lives here)
systray_padding = 4 0 4
systray_background_id = 0
systray_sort = ascending
systray_icon_size = 18
systray_icon_asb = 100 0 0

#---- clock
time1_format = %H:%M
time1_font = IosevkaTerm Nerd Font Mono Bold 10
time2_format = %a %d %b
time2_font = IosevkaTerm Nerd Font Mono 8
clock_font_color = #d8dee9 100
clock_padding = 8 0
clock_background_id = 0

#---- mouse
mouse_middle = none
mouse_right = close
mouse_scroll_up = toggle
mouse_scroll_down = iconify
